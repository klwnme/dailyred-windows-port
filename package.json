{
  "name": "dailyred-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Windows desktop wrapper for Daily Red",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "package:portable": "node node_modules/electron-builder/cli.js --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.dailyred.desktop",
    "productName": "Daily Red",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist/portable"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Daily-Red-${version}-portable-${arch}.${ext}",
      "forceCodeSigning": false
    },
    "portable": {
      "unpackDirName": "Daily Red"
    }
  }
}
